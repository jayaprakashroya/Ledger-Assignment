{
  "info": {
    "_postman_id": "music-catalog-insights",
    "name": "Music Catalog Insights API",
    "description": "Full REST API collection for Music Catalog Insights Platform\n\n**Base URL**: http://localhost:8080/api\n\n**Auth**: JWT Bearer token (obtain via /auth/register or /auth/login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('token', jsonData.token);",
                  "  pm.environment.set('email', jsonData.email);",
                  "  pm.environment.set('user_id', jsonData.user_id);",
                  "  console.log('✅ Token saved to environment');",
                  "} else {",
                  "  console.log('❌ Registration failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}/auth/register"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('token', jsonData.token);",
                  "  pm.environment.set('email', jsonData.email);",
                  "  pm.environment.set('user_id', jsonData.user_id);",
                  "  console.log('✅ Logged in successfully');",
                  "} else {",
                  "  console.log('❌ Login failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}/auth/login"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
