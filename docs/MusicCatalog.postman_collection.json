    {
      "name": "Library",
      "item": [
        {
          "name": "Get All Library Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/library",
              "host": ["{{base_url}}/library"]
            }
          },
          "response": []
        },
        {
          "name": "Add Album to Library",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('library_item_id', jsonData.id);",
                  "  console.log('✅ Album added, ID:', jsonData.id);",
                  "} else {",
                  "  console.log('❌ Failed to add album:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apple_catalog_id\": \"1234567890\",\n  \"title\": \"Parachutes\",\n  \"artist_name\": \"Coldplay\",\n  \"genre\": \"Alternative Rock\",\n  \"release_date\": \"2000-07-10\",\n  \"track_count\": 12,\n  \"artwork_url\": \"https://example.com/artwork.jpg\",\n  \"price\": 9.99,\n  \"user_rating\": 5,\n  \"user_notes\": \"Great debut album!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/library",
              "host": ["{{base_url}}/library"]
            }
          },
          "response": []
        },
        {
          "name": "Update Library Item (Rating)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_rating\": 4,\n  \"user_notes\": \"Updated notes - still love it!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/library/{{library_item_id}}",
              "host": ["{{base_url}}/library/{{library_item_id}}"],
              "path": ["api", "library", "{{library_item_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Library Item by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/library/{{library_item_id}}",
              "host": ["{{base_url}}/library/{{library_item_id}}"],
              "path": ["api", "library", "{{library_item_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Library Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/library/{{library_item_id}}",
              "host": ["{{base_url}}/library/{{library_item_id}}"],
              "path": ["api", "library", "{{library_item_id}}"]
            }
          },
          "response": []
        }
      ]
